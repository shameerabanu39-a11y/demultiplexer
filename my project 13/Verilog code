module demux1to4 (
    input  wire D,
    input  wire S1,
    input  wire S0,
    output reg  Y0,
    output reg  Y1,
    output reg  Y2,
    output reg  Y3
);

always @(*) begin

    // Default all outputs to 0
    Y0 = 1'b0;
    Y1 = 1'b0;
    Y2 = 1'b0;
    Y3 = 1'b0;

    case ({S1, S0})
        2'b00: Y0 = D;
        2'b01: Y1 = D;
        2'b10: Y2 = D;
        2'b11: Y3 = D;
        default: begin
            Y0 = 1'b0;
            Y1 = 1'b0;
            Y2 = 1'b0;
            Y3 = 1'b0;
        end
    endcase

end

endmodule